# .env.example
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun. .env ASLA commit edilmez.

# Google Gemini API anahtarı (ücretsiz katman): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ücretsiz katman modeli. Örn: gemini-2.0-flash veya gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# --- X (Twitter) resmi API anahtarları (publisher_type: x_api için) ---
# developer.x.com > proje/uygulama > Keys and tokens'tan alınır (ücretsiz katman).
# Uygulama izni "Read and write" olmalı.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# X oturumu — SADECE publisher_type: twitter_browser kullanırsan gerekir (API'de gereksiz).
SESSION_B64_HABER=

# "1" ise hiçbir şey paylaşılmaz, yalnızca log basılır (güvenli test).
DRY_RUN=1

# Log seviyesi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Yerel tarayıcı kanalı (isteğe bağlı). Windows'ta indirilen Chromium
# çalışmazsa "msedge" veya "chrome" yaz. GitHub Actions'ta BOŞ bırak → Chromium.
PLAYWRIGHT_CHANNEL=
